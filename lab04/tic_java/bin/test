#!/bin/bash

set -e

cd "$(dirname "$0")/.."

# Compile the application
javac -encoding UTF-8 --source-path . -d tic Tic.java

# Compile the tests
javac -encoding UTF-8 --source-path . -d tic -cp tic:lib/junit-platform-console-standalone-1.7.1.jar TicTest.java
java -jar lib/junit-platform-console-standalone-1.7.1.jar --class-path tic --scan-class-path
