#!/bin/bash

# Compile the application
javac -encoding UTF-8 --source-path src -d dist src/*.java

# Compile the tests
javac -encoding UTF-8 --source-path test -d dist -cp dist:lib/easymock-5.6.0.jar:lib/byte-buddy-1.17.5.jar:lib/asm-9.8.jar:lib/objenesis-3.4.jar:lib/junit-platform-console-standalone-1.7.1.jar test/*.java
